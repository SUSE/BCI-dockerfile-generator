#!UseOBSRepositories
#!ExclusiveArch: aarch64 x86_64
#!BuildTag: bci/dotnet-aspnet:10.0.13-micro-%RELEASE%
#!BuildTag: bci/dotnet-aspnet:10.0.13-micro

            /tmp/nvidia-persistenced-615.71.09-1.aarch64.rpm \
            /tmp/nvlsm-2025.12.211-1.aarch64.rpm; \
    fi

RUN set -euo pipefail; if rpm --root /target -q compat-usrmerge-tools; then rpm --root /target -e compat-usrmerge-tools; fi

RUN set -euo pipefail; if [ "$(uname -m)" = "x86_64" ]; then \
        rpm --root /target -ivh --force --nodeps --justdb --noscripts \
            /tmp/nvidia-open-driver-G07-signed-cuda-kmp-default-615.71.09_k6.4.0_150700.53.78-150700.16.22.1.x86_64.rpm; \
    fi

